# Vercel Blob — create a Blob store in the Vercel dashboard, it injects this for you.
# Without it, uploaded photos are squeezed into the link itself (longer links).
BLOB_READ_WRITE_TOKEN=

# Resend — only used to save opted-in emails to an Audience (mailing list).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# set to 1 once the two above are filled in, to show the opt-in checkbox
NEXT_PUBLIC_MAILING_LIST=

# Public URL used in posters and QR codes when not on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
